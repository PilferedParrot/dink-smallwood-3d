# Source-fitted structural stone spans. The source masks and donor evidence are
# generated by tools/rc5_wall_fit.py; only selected static owners are replaced.
extends RefCounted

const WALL_DATA := "res://prototype/rc5_walls.json"
const BUILDINGS := preload("res://scripts/sprite_buildings.gd")
const WIDTH := 640
const HEIGHT := 400
const SCALE := 0.025

var fp_world
var source_host
var data: Dictionary = {}
var _floor: Dictionary = {}
var _clear: Dictionary = {}
var _built: Dictionary = {} # screen -> live composed node in this scene

func _init(world = null, host = null) -> void:
	fp_world = world
	source_host = world.host if world != null else host
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(WALL_DATA))
	if parsed is Dictionary and int(parsed.get("schema", 0)) == 1:
		data = parsed
	else:
		push_error("RC5 stone walls: missing fit or wrong schema")

func reset() -> void:
	_built.clear()

func get_fit(screen: int, vision: int = 0) -> Dictionary:
	# Every selected owner is vision 0, so the same static source body is also
	# visible in subsequent vision layers.
	var _vision: int = vision
	return data.get("screens", {}).get(str(screen), {})

func _mask(screen: int, field: String, cache: Dictionary) -> PackedByteArray:
	if cache.has(screen): return cache[screen]
	var out := PackedByteArray()
	out.resize(WIDTH * HEIGHT)
	var fit := get_fit(screen)
	for row in fit.get(field, []):
		var y := int(row[0])
		if y < 0 or y >= HEIGHT: continue
		for x in range(maxi(20, int(row[1])), mini(620, int(row[2]))):
			out[y * WIDTH + x] = 1
	cache[screen] = out
	return out

func _cell(mask: PackedByteArray, x: int, y: int) -> bool:
	return x >= 20 and x < 620 and y >= 0 and y < HEIGHT and mask[y * WIDTH + x] != 0

func owns(e: Dictionary, screen: int, vision: int = 0) -> bool:
	var fit := get_fit(screen, vision)
	if fit.is_empty() or int(e.get("type", 1)) != 1 or int(e.get("size", 100)) != 100:
		return false
	if int(e.get("vision", 0)) != 0 or int(e.get("active", 1)) == 0:
		return false
	if bool(e.get("runtime_created",false)) or int(e.get("brain",0)) != 0: return false
	if int(e.get("nodraw", 0)) != 0 or int(e.get("disabled", 0)) != 0 or not str(e.get("script", "")).is_empty():
		return false
	var index := int(e.get("editor_num", 0))
	if index == 0: index = int(e.get("index", 0))
	var seq := int(e.get("pseq", 0))
	if seq == 0: seq = int(e.get("seq", 0))
	var frame := int(e.get("pframe", 0))
	if frame == 0: frame = int(e.get("frame", 0))
	var path := str(e.get("path", ""))
	if source_host != null:
		path = str(source_host._frame(seq, frame).get("path", ""))
	for owner in fit.get("owners", []):
		if int(owner["index"]) == index and int(owner["seq"]) == seq and int(owner["frame"]) == frame and str(owner["path"]) == path:
			return true
	return false

func hardbox_replaced(e: Dictionary, screen: int, vision: int = 0) -> bool:
	if not owns(e, screen, vision): return false
	return int(e.get("hard", 1)) == 0

func clears_tile(pos: Vector2, screen: int, vision: int = 0) -> bool:
	if get_fit(screen, vision).is_empty(): return false
	if pos.x < 20.0 or pos.x >= 620.0 or pos.y < 0.0 or pos.y >= 400.0: return false
	return _cell(_mask(screen, "clear_tile_runs", _clear), int(pos.x), int(pos.y))

func _inside(pos: Vector2, floor_mask: PackedByteArray) -> bool:
	return _cell(floor_mask, floori(pos.x), floori(pos.y))

# A point is in the walls when it is in a cell of this screen's floor mask, or of the neighbour screen it has crossed into.
func blocked(pos: Vector2, _from: Vector2, screen: int, vision: int = 0) -> bool:
	var _layer: int = vision
	var column := (screen-1)%32
	for dz in range(-1,2):
		if dz < 0 and pos.y >= 0.0: continue
		if dz > 0 and pos.y < HEIGHT: continue
		for dx in range(-1,2):
			if column+dx < 0 or column+dx >= 32: continue
			if dx < 0 and pos.x >= 20.0: continue
			if dx > 0 and pos.x < 620.0: continue
			var n := screen+dx+32*dz
			if get_fit(n).is_empty(): continue
			if _inside(pos-Vector2(dx*600,dz*400),_mask(n,"floor_runs",_floor)): return true
	return false

# The wall cells within `limit` of `pos`, in this screen and the neighbours it overlaps: the distance field of `blocked`.
# `best` is [distance, closest point]; see game.gd _solid_nearest_here.
func offer_nearest(best: Array, pos: Vector2, limit: float, screen: int) -> void:
	var column := (screen-1)%32
	for dz in range(-1,2):
		if dz < 0 and pos.y-limit >= 0.0: continue
		if dz > 0 and pos.y+limit < HEIGHT: continue
		for dx in range(-1,2):
			if column+dx < 0 or column+dx >= 32: continue
			if dx < 0 and pos.x-limit >= 20.0: continue
			if dx > 0 and pos.x+limit < 620.0: continue
			var n := screen+dx+32*dz
			if get_fit(n).is_empty(): continue
			var shift := Vector2(dx*600,dz*400)
			var local := pos-shift
			var cells := _mask(n,"floor_runs",_floor)
			for y in range(maxi(0,floori(local.y-limit)),mini(HEIGHT-1,floori(local.y+limit))+1):
				for x in range(maxi(20,floori(local.x-limit)),mini(619,floori(local.x+limit))+1):
					if cells[y*WIDTH+x] == 0: continue
					var at := local.clamp(Vector2(x,y),Vector2(x+1-0.001,y+1-0.001)) # half-open cell: a point on its far edge is outside
					var d := local.distance_to(at)
					if d <= limit and d < (best[0] as float):
						best[0] = d
						best[1] = at+shift

func add(node: Node3D, e: Dictionary, screen: int, id: int, collision: bool) -> void:
	var _id: int = id
	if not owns(e, screen): return
	if _built.has(screen) and is_instance_valid(_built[screen]): return
	var fit := get_fit(screen)
	var group := _build(fit, collision)
	group.name = "StructuralStoneWalls_%d" % screen
	# Mesh pixels use the RC4 source basis: x=20 -> 0 m; z=0 -> 0 m.
	# node already sits at fp_world.point(e.x,e.y) in this backdrop.
	group.position = Vector3(-7.5, 0.0, -5.0) - node.position
	node.add_child(group)
	_built[screen] = group

func _build(fit: Dictionary, collision: bool) -> Node3D:
	var atlas_y0 := float(data.get("camera", {}).get("atlas_y0", -200))
	var atlas_size: Array = data.get("camera", {}).get("atlas_size", [640, 600])
	var h := float(fit.get("shared_height_px", data.get("shared_height_px", 74)))
	var occ := PackedByteArray()
	occ.resize(WIDTH * HEIGHT)
	for row in fit.get("floor_runs", []):
		var z := int(row[0])
		for x in range(int(row[1]), int(row[2])):
			occ[z * WIDTH + x] = 1
	var seen := SurfaceTool.new()
	seen.begin(Mesh.PRIMITIVE_TRIANGLES)
	var inferred := SurfaceTool.new()
	inferred.begin(Mesh.PRIMITIVE_TRIANGLES)
	var donor: Dictionary = fit["unseen_face_material"]
	var donor_w := float(donor["face_size_px"][0])
	var donor_h := float(donor["face_size_px"][1])
	var bounds := _bounds(fit.get("floor_runs", []))
	for row in fit.get("floor_runs", []):
		var z := int(row[0])
		var x0 := int(row[1])
		var x1 := int(row[2])
		# One top quad per exact run retains its pixel contour at row boundaries.
		_quad_seen(seen, Vector3(x0, h, z), Vector3(x1, h, z),
			Vector3(x1, h, z + 1), Vector3(x0, h, z + 1), atlas_y0, atlas_size)
		_quad_inferred(inferred, Vector3(x0, 0, z), Vector3(x0, 0, z + 1),
			Vector3(x0, h, z + 1), Vector3(x0, h, z), true, true, h, donor_w, donor_h, bounds)
		_quad_inferred(inferred, Vector3(x1, 0, z + 1), Vector3(x1, 0, z),
			Vector3(x1, h, z), Vector3(x1, h, z + 1), true, false, h, donor_w, donor_h, bounds)
		var front_start := -1
		var back_start := -1
		for x in range(x0, x1 + 1):
			var front := x < x1 and (z == HEIGHT - 1 or occ[(z + 1) * WIDTH + x] == 0)
			var back := x < x1 and (z == 0 or occ[(z - 1) * WIDTH + x] == 0)
			if front and front_start < 0: front_start = x
			if not front and front_start >= 0:
				_quad_seen(seen, Vector3(front_start, 0, z + 1), Vector3(x, 0, z + 1),
					Vector3(x, h, z + 1), Vector3(front_start, h, z + 1), atlas_y0, atlas_size)
				front_start = -1
			if back and back_start < 0: back_start = x
			if not back and back_start >= 0:
				_quad_inferred(inferred, Vector3(x, 0, z), Vector3(back_start, 0, z),
					Vector3(back_start, h, z), Vector3(x, h, z), false, true, h, donor_w, donor_h, bounds)
				back_start = -1
	var mesh := seen.commit()
	mesh = inferred.commit(mesh)
	var atlas := _source_atlas(fit.get("atlas_owners", fit.get("owners", [])), int(atlas_size[0]), int(atlas_size[1]), atlas_y0)
	var texture: ImageTexture = BUILDINGS.new({}, {}, {}, SCALE).fill_holes(atlas)
	var front_mat := StandardMaterial3D.new()
	front_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	front_mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	front_mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST_WITH_MIPMAPS
	front_mat.albedo_texture = texture
	var back_mat := StandardMaterial3D.new()
	back_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	back_mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	back_mat.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST_WITH_MIPMAPS
	back_mat.texture_repeat = true
	back_mat.albedo_texture = _donor_face_texture(donor)
	var group := Node3D.new()
	group.set_meta("unseen_face_inference", donor["inference"])
	group.set_meta("owner_indexes", fit["owner_indexes"])
	var shell := MeshInstance3D.new()
	shell.name = "SourceWallShell"
	shell.mesh = mesh
	shell.set_surface_override_material(0, front_mat)
	shell.set_surface_override_material(1, back_mat)
	group.add_child(shell)
	if collision:
		var body := StaticBody3D.new()
		body.name = "StoneWallRayBody"
		body.collision_layer = 1
		body.collision_mask = 0
		var shape := CollisionShape3D.new()
		var triangles := mesh.create_trimesh_shape()
		if triangles is ConcavePolygonShape3D: triangles.backface_collision = true
		shape.shape = triangles
		body.add_child(shape)
		group.add_child(body)
	return group

func _bounds(rows: Array) -> Vector4:
	var x0 := INF
	var x1 := -INF
	var z0 := INF
	var z1 := -INF
	for row in rows:
		x0 = minf(x0, float(row[1]))
		x1 = maxf(x1, float(row[2]))
		z0 = minf(z0, float(row[0]))
		z1 = maxf(z1, float(row[0]) + 1.0)
	return Vector4(x0, x1, z0, z1)

func _source_atlas(owners: Array, width: int, height: int, y0: float) -> Image:
	var atlas := Image.create(width, height, false, Image.FORMAT_RGBA8)
	atlas.fill(Color.TRANSPARENT)
	for owner in owners:
		var tex: Texture2D = load("res://" + str(owner["path"]))
		if tex == null:
			push_error("RC5 stone walls: missing source image " + str(owner["path"]))
			continue
		var src := tex.get_image()
		if src.is_compressed(): src.decompress()
		src.convert(Image.FORMAT_RGBA8)
		atlas.blend_rect(src, Rect2i(Vector2i.ZERO, src.get_size()),
			Vector2i(int(owner["at"][0]), int(float(owner["at"][1]) - y0)))
	return atlas

func _donor_face_texture(donor: Dictionary) -> ImageTexture:
	var tex: Texture2D = load("res://" + str(donor["source_path"]))
	var image := tex.get_image()
	if image.is_compressed(): image.decompress()
	image.convert(Image.FORMAT_RGBA8)
	var crop := image.get_region(Rect2i(0, int(donor["face_crop_rows"][0]),
		int(donor["face_size_px"][0]), int(donor["face_size_px"][1])))
	crop.generate_mipmaps()
	return ImageTexture.create_from_image(crop)

func _quad_seen(st: SurfaceTool, a: Vector3, b: Vector3, c: Vector3, d: Vector3,
		y0: float, atlas_size: Array) -> void:
	for p in [a, b, c, a, c, d]:
		st.set_uv(Vector2(p.x / float(atlas_size[0]), (p.z - p.y - y0) / float(atlas_size[1])))
		st.add_vertex(Vector3((p.x - 20.0) * SCALE, p.y * SCALE, p.z * SCALE))

func _quad_inferred(st: SurfaceTool, a: Vector3, b: Vector3, c: Vector3, d: Vector3,
		along_z: bool, reverse: bool, h: float, donor_w: float, donor_h: float,
		bounds: Vector4) -> void:
	for p in [a, b, c, a, c, d]:
		var run: float = p.z - bounds.z if along_z else p.x - bounds.x
		if reverse: run = bounds.w - p.z if along_z else bounds.y - p.x
		var v: float = (donor_h - 0.5 - (donor_h - 1.0) * p.y / h) / donor_h
		st.set_uv(Vector2(run / donor_w, v))
		st.add_vertex(Vector3((p.x - 20.0) * SCALE, p.y * SCALE, p.z * SCALE))
