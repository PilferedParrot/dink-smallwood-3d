extends SceneTree
# Native physics-ray census for the static source-eligible actor targets.
# The candidate JSON is generated by tmp/rc5-pocket-audit/ray_candidates.py
# from before/after static reachable cells; trigger-only records are counted
# separately. No campaign or screen scripts run.

const GAME = preload("res://scripts/fps_game.gd")

func _initialize() -> void:
	_run.call_deferred()

func _query(game, id: int, actor: Vector2, points: Array) -> Dictionary:
	var result := {"candidate_cells": points.size(), "line_clear_cells_tested": 0,
		"ray_cells_tested": 0, "ray_reaches": false, "witness_xy": []}
	for xy in points:
		var at := Vector2(float(xy[0]), float(xy[1]))
		game.entities[1].x = at.x
		game.entities[1].y = at.y
		game.fps_yaw = atan2(-(actor.x - at.x), -(actor.y - at.y))
		game.fps_pitch = -0.08
		game._sync_fps_camera()
		var line_target: Vector2 = game._fps_interaction_position(id) if game.has_method("_fps_interaction_position") else actor
		if not game._fps_line_clear(at, line_target): continue
		result["line_clear_cells_tested"] = int(result["line_clear_cells_tested"]) + 1
		result["ray_cells_tested"] = int(result["ray_cells_tested"]) + 1
		if game._fps_ray_reaches(id):
			result["ray_reaches"] = true
			result["witness_xy"] = [at.x, at.y]
			break
	return result

func _run() -> void:
	var candidates_path := ""
	var output_path := ""
	var baseline_before := false
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--candidates="): candidates_path = arg.trim_prefix("--candidates=")
		if arg.begins_with("--out="): output_path = arg.trim_prefix("--out=")
		if arg == "--baseline-before": baseline_before = true
	if candidates_path.is_empty() or output_path.is_empty():
		push_error("Pass -- --candidates=<absolute json> --out=<absolute json>")
		quit(2)
		return
	var source: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(candidates_path))
	if str(source.get("schema", "")) != "rc5-native-entity-ray-candidates-1":
		push_error("Wrong candidate schema")
		quit(2)
		return
	var grouped: Dictionary = {}
	for record in source["records"]:
		grouped.get_or_add(int(record["screen"]), []).append(record)
	var screens: Array = grouped.keys()
	screens.sort()
	var game = GAME.new()
	game.test_mode = true
	root.add_child(game)
	await process_frame
	game.vm.cancel_all()
	game.vm.globals["vision"] = 0
	game.playing = false
	var results: Array = []
	for screen in screens:
		game.vm.cancel_all()
		game.load_map(int(screen), false)
		await process_frame
		await physics_frame
		game.vm.cancel_all()
		for record in grouped[screen]:
			var id := 0
			for candidate in game.entities:
				if int(candidate) == 1: continue
				var e: Dictionary = game.entities[candidate]
				if int(e.get("editor_num", -1)) != int(record["editor_index"]): continue
				if absf(float(e.get("x", 0)) - float(record["source_xy"][0])) > 1.0: continue
				if absf(float(e.get("y", 0)) - float(record["source_xy"][1])) > 1.0: continue
				id = int(candidate)
				break
			var item := {"screen": int(screen), "list_index": int(record["list_index"]),
				"editor_index": int(record["editor_index"]), "mode": str(record["mode"]),
				"script": str(record["script"]), "source_xy": record["source_xy"],
				"source_entity_id": id, "before": {}, "after": {}, "status": ""}
			if id == 0 or not game.visuals.has(id) or not is_instance_valid(game.visuals[id]):
				item["status"] = "SOURCE_ENTITY_OR_VISUAL_MISSING_UNVERIFIED"
				results.append(item)
				continue
			var e: Dictionary = game.entities[id]
			if int(e.get("active", 1)) == 0 or int(e.get("nohit", 0)) != 0 and str(e.get("script", "")).is_empty():
				item["status"] = "SOURCE_STATE_NOT_TARGETABLE_UNVERIFIED"
				results.append(item)
				continue
			var actor := Vector2(float(e.x), float(e.y))
			item["before"] = _query(game,id,actor,record["before_points"])
			if not baseline_before:
				item["after"] = _query(game,id,actor,record["after_points"])
			var old_ray: bool = item["before"]["ray_reaches"]
			if baseline_before:
				item["status"] = "BASELINE_OLD_FORMULA_RAY" if old_ray else "BASELINE_OLD_FORMULA_NO_SAMPLED_RAY"
			else:
				var new_ray: bool = item["after"]["ray_reaches"]
				if old_ray and new_ray: item["status"] = "RAY_RETAINED_FROM_BEFORE_AND_AFTER_CELLS"
				elif old_ray and not new_ray: item["status"] = "POTENTIAL_LOST_AFTER_RAY"
				elif new_ray: item["status"] = "AFTER_RAY_EXISTS_BEFORE_SAMPLE_MISSED"
				else: item["status"] = "NO_SAMPLED_OWN_RAY_UNVERIFIED"
			results.append(item)
		if int(screen) % 100 == 0:
			print("RAY CENSUS screen ", screen, " records ", results.size())
	var counts: Dictionary = {}
	var modes: Dictionary = {}
	for item in results:
		counts[item["status"]] = int(counts.get(item["status"], 0)) + 1
		modes[item["mode"]] = int(modes.get(item["mode"], 0)) + 1
	var output := {"schema": "rc5-native-entity-ray-census-1",
		"mode": "baseline_archive_old_formula_before_cells" if baseline_before else "current_integrated_new_formula_before_and_after_cells",
		"source_eligible_records": int(source["source_eligible_records"]),
		"trigger_only_excluded": source["trigger_only_excluded"],
		"nonstanding_ray_ineligible": source["nonstanding_ray_ineligible"],
		"ray_target_records": results.size(), "screens_loaded": screens.size(),
		"counts_by_status": counts, "counts_by_mode": modes, "records": results,
		"limits": ["Candidate cells are sampled from exact before/after static-warp-reachable masks and source authored ranges; baseline archive evaluates only the before set with its old ray formula, while current game evaluates both sets with the integrated helper.",
			"A missed sample does not prove no visible surface exists; candidate list is angularly stratified and capped per target.",
			"No campaign/screen scripts run, so actors changed by startup or story state remain unverified.",
			"A ray hit alone does not execute talk/attack input or prove framing; live savebot dispatch is tested separately."]}
	var file := FileAccess.open(output_path, FileAccess.WRITE)
	file.store_string(JSON.stringify(output, "\t"))
	print("RAY CENSUS records=%d screens=%d statuses=%s" % [results.size(), screens.size(), str(counts)])
	game.queue_free()
	await process_frame
	await process_frame
	quit(0)
