extends SceneTree
const B = preload("res://scripts/input_bindings.gd")
var failures: Array[String] = []
func check(value: bool, message: String) -> void:
	if not value: failures.append(message); push_error(message)
func write(path: String, text: String) -> void:
	var file := FileAccess.open(path,FileAccess.WRITE)
	file.store_string(text); file.close()
func _initialize() -> void: _run.call_deferred()
func _run() -> void:
	var b = B.new("fps","user://mutations.json")
	write(b.settings_path,JSON.stringify({"music":0.37,"bindings_v1":{"version":1,"contexts":{"fps":{"magic":[B.key(KEY_K)],"attack":[B.key(KEY_K)],"talk":[B.key(KEY_J)]}}}}))
	b.load_settings()
	check(b.events("attack") == [B.key(KEY_K)] and b.events("magic") == b.defaults("magic"),"Registry-order collision keeps attack, drops magic despite reversed JSON order")
	check(b.events("talk") == [B.key(KEY_J)] and not b.warnings.is_empty(),"Collision retains unrelated override and warns")
	b.load_overrides({"version":1,"contexts":{"fps":{"magic":[B.key(KEY_Q)],"attack":[B.key(KEY_Q)]}}})
	check(b.events("attack") == [B.key(KEY_Q)],"First override survives even when later default names the same key")
	check(not b.events("magic").has(B.key(KEY_Q)) and b.events("magic").has(B.mouse(MOUSE_BUTTON_RIGHT)),"Later collision removes only colliding fallback slots")
	for sample in ["not json",JSON.stringify({"music":0.4,"bindings_v1":{"version":2,"contexts":{"future":{"unknown":"keep"}}}})]:
		var backup = B.new("fps","user://backup-%s.json" % sample.length())
		write(backup.settings_path,sample); backup.load_settings()
		check(backup.set_bindings("attack",[B.key(KEY_K)]).ok,"Explicit change after unreadable/newer file succeeds safely")
		check(FileAccess.file_exists(backup.settings_path+".bak") and FileAccess.get_file_as_string(backup.settings_path+".bak") == sample,"Unreadable/newer bytes backed up before replacement")
		var future := JSON.stringify({"bindings_v1":{"version":3,"contexts":{}},"keep":"second original"})
		write(backup.settings_path,future); backup.load_settings()
		check(backup.set_bindings("attack",[B.key(KEY_J)]).ok,"Second recovery preserves existing backup")
		check(FileAccess.get_file_as_string(backup.settings_path+".bak") == sample and FileAccess.get_file_as_string(backup.settings_path+".bak.1") == future,"Existing backup never overwritten")
	if b.has_method("save_settings"):
		var volume = B.new("fps","user://volume-save.json")
		write(volume.settings_path,"unreadable settings");volume.load_settings()
		volume.settings.music = 0.5
		check(volume.save_settings().ok and FileAccess.get_file_as_string(volume.settings_path+".bak") == "unreadable settings","Ordinary setting writes preserve unreadable original too")
	check(b.has_method("add_binding") and b.has_method("replace_binding") and b.has_method("remove_binding"),"Per-slot mutation API exists")
	if b.has_method("replace_binding"):
		check(b.reset_all().ok,"Reset clean defaults")
		var original: Array = b.events("attack")
		check(b.add_binding("attack",B.key(KEY_K)).ok,"Add keyboard slot")
		check(b.events("attack").slice(0,original.size()) == original,"Add preserves all other devices")
		check(b.replace_binding("attack",original.size(),B.key(KEY_L)).ok,"Replace only keyboard slot")
		check(b.events("attack").slice(0,original.size()) == original,"Replace preserves all other devices")
		check(b.remove_binding("attack",original.size()).ok and b.events("attack") == original,"Remove only selected slot")
		check(not b.replace_binding("attack",999,B.key(KEY_K)).ok,"Invalid index refused")
		check(b.add_binding("attack",B.key(KEY_K)).ok and b.add_binding("magic",B.key(KEY_J)).ok,"Prepare per-slot swap")
		var attack_index: int = b.events("attack").size()-1
		var magic_before: Array = b.events("magic")
		var swapped: Dictionary = b.replace_binding("attack",attack_index,B.key(KEY_J),"swap")
		check(swapped.ok and b.events("attack")[attack_index] == B.key(KEY_J),"Per-slot swap installs requested key")
		var expected := magic_before.duplicate(true); expected[expected.size()-1] = B.key(KEY_K)
		check(b.events("magic") == expected and b.events("attack").slice(0,original.size()) == original,"Per-slot swap keeps every unrelated slot")
		var before: String = FileAccess.get_file_as_string(b.settings_path)
		check(not b.add_binding("talk",B.key(KEY_J),"swap").ok and FileAccess.get_file_as_string(b.settings_path) == before,"Adding cannot steal a conflicting slot without exchange source")
		var reloaded = B.new("fps",b.settings_path);reloaded.load_settings()
		check(reloaded.events("attack") == b.events("attack") and reloaded.events("magic") == b.events("magic"),"Per-slot swaps persist")
		check(b.reset_all().ok,"Reset before essential swap guard")
		check(b.set_bindings("ui_up",[B.key(KEY_F14),B.pad(JOY_BUTTON_PADDLE2)]).ok,"Prepare essential source")
		check(b.set_bindings("ui_accept",[B.key(KEY_F13),B.pad(JOY_BUTTON_PADDLE1),B.pad(JOY_BUTTON_PADDLE3)]).ok,"Prepare essential destination")
		before = FileAccess.get_file_as_string(b.settings_path)
		var guarded: Dictionary = b.replace_binding("ui_accept",1,B.key(KEY_F14),"swap")
		check(not guarded.ok and guarded.error == "menu_device_required" and guarded.action == "ui_up" and guarded.device == "keyboard","Swap protects the other action's final device slot")
		check(FileAccess.get_file_as_string(b.settings_path) == before,"Refused guarded swap leaves bytes intact")
	print("MUTATION REVIEW PASS" if failures.is_empty() else "MUTATION REVIEW FAIL "+str(failures.size()))
	quit(0 if failures.is_empty() else 1)
